# ---------------------------------------------------------------------------
# Reservation emails (Resend) — /api/reserve
# ---------------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender shown to recipients. The domain/address MUST be verified in Resend.
MAIL_FROM=Phở Restaurant Konstanz <reservierung@your-verified-domain.de>

# Where reservation requests are delivered (the restaurant's inbox).
RESERVATION_TO=inhaber@pho-konstanz.de
RESERVATION_TO_NAME=Phở Restaurant Konstanz

# ---------------------------------------------------------------------------
# Owner admin (/admin)
# ---------------------------------------------------------------------------
# scrypt hash of the owner password, as "saltHex:hashHex".
# Generate with:  npm run hash-password -- "the password"
OWNER_PASSWORD_HASH=

# Random secret the admin session cookie is signed with. Changing it logs
# everyone out. Generate with:  openssl rand -base64 32
COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Storage — set automatically when you connect a Vercel Blob store
# ---------------------------------------------------------------------------
# Without it the site still serves the committed seed/ copies, but the owner
# admin cannot save.
BLOB_READ_WRITE_TOKEN=
